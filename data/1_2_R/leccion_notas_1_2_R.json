    },
    {
     "tipo": "ejemplo",
     "gu": "આ મારી છોકરી છે.",
     "detalle": "-ી · ella (femenino)",
     "significado": "esta es mi hija",
     "audio": "audios/clase_1_1/nota_1_2_R_02.mp3"
    },
    {
     "tipo": "ejemplo",
     "gu": "આ મારું નામ છે.",
     "detalle": "-ું · eso (neutro)",
     "significado": "este es mi nombre",
     "audio": "audios/clase_1_1/nota_1_2_R_03.mp3"
    }
   ]
  },
  {
   "destacado": true,
   "bloques": [
    {
     "tipo": "texto",
     "html": "Y dos finales más: <strong>-ા</strong> para varios o para una persona a la que se respeta, y <strong>-ાં</strong> para varias cosas."
