    {
     "tipo": "texto",
     "html": "La palabra que acompaña (mío, bueno, nuevo…) cambia su final según acompañe a <strong>él</strong>, a <strong>ella</strong> o a <strong>eso</strong>."
    },
    {
     "tipo": "ejemplo",
     "gu": "આ મારો છોકરો છે.",
     "detalle": "-ો · él (masculino)",
     "significado": "este es mi hijo",
