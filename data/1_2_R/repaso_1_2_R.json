 "dialogo": {
  "titulo": "Al llegar a la reunión",
  "intro": "Vina lleva a Seema por primera vez a la reunión, y Manisha la recibe. Todo lo que dicen ya lo sabes leer.",
  "avatares": {
   "manisha": {
