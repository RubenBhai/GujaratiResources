  "lineas": [
   {
    "quien": "manisha",
    "gu": "નમસ્તે વીણા! આવો, આવો!",
    "es": "¡Hola, Vina! ¡Pasen, pasen!",
    "audio": "audios/clase_1_1/dialogo_1_2_R_01.mp3"
   },
   {
    "quien": "vina",
    "gu": "નમસ્તે મનિષાબેન. આ સીમાબેન છે.",
    "es": "Hola, Manisha. Ella es Seema.",
    "audio": "audios/clase_1_1/dialogo_1_2_R_02.mp3"
   },
   {
    "quien": "manisha",
    "gu": "નમસ્તે સીમાબેન! તમે કેમ છો?",
    "es": "¡Hola, Seema! ¿Cómo está?",
    "audio": "audios/clase_1_1/dialogo_1_2_R_03.mp3"
   },
   {
    "quien": "seema",
    "gu": "હું મજામાં છું.",
    "es": "Estoy muy bien.",
    "audio": "audios/clase_1_1/dialogo_1_2_R_04.mp3"
   },
   {
    "quien": "vina",
    "gu": "અમે સાથે બાઈબલની વાત કરીએ છીએ.",
    "es": "Hablamos juntas de la Biblia.",
    "audio": "audios/clase_1_1/dialogo_1_2_R_05.mp3"
   },
   {
    "quien": "manisha",
    "gu": "સરસ! તમે અહીં પહેલી વાર આવ્યા?",
    "es": "¡Qué bien! ¿Es la primera vez que viene?",
    "audio": "audios/clase_1_1/dialogo_1_2_R_06.mp3"
   },
   {
    "quien": "seema",
    "gu": "હા, પહેલી વાર.",
    "es": "Sí, la primera vez.",
    "audio": "audios/clase_1_1/dialogo_1_2_R_07.mp3"
   },
   {
    "quien": "manisha",
    "gu": "તમે ક્યાં રહો છો?",
    "es": "¿Dónde vive usted?",
    "audio": "audios/clase_1_1/dialogo_1_2_R_08.mp3"
   },
   {
    "quien": "seema",
    "gu": "હું અહીં પાસે જ રહું છું.",
    "es": "Vivo aquí cerca.",
    "audio": "audios/clase_1_1/dialogo_1_2_R_09.mp3"
   },
   {
    "quien": "vina",
    "gu": "આ મારા પતિ, પરેશ. અને આ મારી છોકરી, રોશની.",
    "es": "Este es mi esposo, Paresh. Y esta es mi hija, Roshni.",
    "audio": "audios/clase_1_1/dialogo_1_2_R_10.mp3"
   },
   {
    "quien": "roshni",
    "gu": "નમસ્તે, સીમામાસી!",
    "es": "¡Hola, tía Seema!",
    "audio": "audios/clase_1_1/dialogo_1_2_R_11.mp3"
   },
   {
    "quien": "manisha",
    "gu": "સીમાબેન, રવિવારે અમારી સાથે જમવા આવો ને.",
    "es": "Seema, venga el domingo a comer con nosotros.",
    "audio": "audios/clase_1_1/dialogo_1_2_R_12.mp3"
   },
   {
    "quien": "seema",
    "gu": "જરૂર! હું આવીશ.",
    "es": "¡Claro! Iré.",
    "audio": "audios/clase_1_1/dialogo_1_2_R_13.mp3"
   }
  ]
 }
