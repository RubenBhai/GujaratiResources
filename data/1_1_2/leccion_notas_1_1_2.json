        "2",
        "6"
      ],
      "bloques": [
        {
          "tipo": "texto",
          "html": "Los <strong>posesivos</strong> cambian según el género y el número de lo que poseen.<br><span class=\"gu\">મારો</span> = <strong>mío</strong> (masculino singular)."
        },
        {
          "tipo": "ejemplo",
          "gu": "મારો છોકરો",
          "literal": "mi niño",
          "significado": "mi niño"
        },
        {
          "tipo": "ejemplo",
          "gu": "મારો સરકાર",
          "literal": "mi gobierno",
          "significado": "mi gobierno"
        },
        {
          "tipo": "texto",
          "html": "<span class=\"gu\">અમારો</span> = <strong>nuestro</strong> (masculino singular)."
        },
        {
          "tipo": "ejemplo",
          "gu": "અમારો સહારો",
          "literal": "nuestro apoyo",
          "significado": "nuestro apoyo"
