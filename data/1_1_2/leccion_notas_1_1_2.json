      ],
      "bloques": [
        {
          "tipo": "texto",
          "html": "Cuando lo que se posee es <strong>plural masculino</strong>, el posesivo termina en <span class=\"gu\">-આ</span>:<br><span class=\"gu\">મારા</span> = mío, <span class=\"gu\">અમારા</span> = nuestro."
        },
        {
          "tipo": "ejemplo",
