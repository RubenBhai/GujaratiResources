          "tipo": "info-box",
          "html": "<p style=\"text-align: center;\"><span style=\"font-family:'Noto Serif Gujarati',serif;color:var(--sindoor-azul);font-size:1.5rem;font-weight:600\">નમસ્તે</span> - <span style=\"color:var(--rojo-ladrillo);font-size:1.5rem;font-weight:600\">namaste</span> - <span style=\"color:var(--sindoor-azul);font-size:1.5rem;font-weight:600\">hola</span></p>"
