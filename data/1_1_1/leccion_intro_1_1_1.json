    },
    {
      "badge": "Resumen",
      "titulo": "Las consonantes y sus matras",
      "bloques": [
        {
          "tipo": "info-box",
          "html": "<p>Para cobinar una consonante con una vocal, usamos la matra de la vocal. Por ejemplo, para combinar ક  con con આ  sería ક 'ka' +  ા (matra de 'aa') =  કા 'kaa'.  Mira los siguientes ejemplos:</p>"
        },
        {
          "tipo": "tabla",
          "columnas": ["Gujarati", "Sonido", "Matra", "Letra+Matra"],
          "filas": [
            [ {"tipo":"gu","valor":"ક"}, {"tipo":"texto","valor":"<strong>ka</strong>"}, {"tipo":"gu","valor":"ા"}, {"tipo":"texto","valor":"<strong>ક + ા  =  કા (kaa)</strong>"} ],
            [ {"tipo":"gu","valor":"મ"}, {"tipo":"texto","valor":"<strong>ma</strong>"}, {"tipo":"gu","valor":"ે"}, {"tipo":"texto","valor":"<strong>મ + ે  =  મે (me)</strong>"} ],
            [ {"tipo":"gu","valor":"છ"}, {"tipo":"texto","valor":"<strong>chha</strong>"}, {"tipo":"gu","valor":"ો"}, {"tipo":"texto","valor":"<strong>છ + ો  =  છો (chho)</strong>"} ]
          ]
        }
